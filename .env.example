# Server-only monday.com API credentials. Do not expose these to browser code.
MONDAY_API_TOKEN=
MONDAY_DEALS_BOARD_ID=
MONDAY_WORK_ORDERS_BOARD_ID=
MONDAY_API_VERSION=2025-10
PORT=3000
CACHE_TTL_MS=30000
# Optional Bedrock enhancement. Keep this server-side; never put it in browser code.
AWS_BEDROCK_ENABLED=false
AWS_BEARER_TOKEN_BEDROCK=
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-6
AWS_BEDROCK_TIMEOUT_MS=20000
